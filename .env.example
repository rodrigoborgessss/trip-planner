# Copia para .env e preenche conforme fores ligando os fornecedores.
PORT=3000
CACHE_TTL_MIN=60

# Voos — Duffel (https://duffel.com). Cria um token no dashboard.
#   Token de teste: duffel_test_xxx   |   Produção: duffel_live_xxx
#   O token de teste devolve dados de exemplo da Duffel; só o live traz preços reais.
DUFFEL_TOKEN=
DUFFEL_VERSION=v2

# Hotéis — Travelpayouts/Hotellook (afiliado, gratuito). Token + marker no dashboard.
HOTELS_TOKEN=
HOTELS_MARKER=

# Lazer e cultura — OpenTripMap (gratuito, chave free em opentripmap.io). Sem cartão.
ACTIVITIES_TOKEN=

# Segurança e avisos (GeoSure / travel-advisory.info / TuGo)
SAFETY_TOKEN=

# Fotos de cidades — Pexels (https://www.pexels.com/api, gratuito).
# Sem esta chave, as fotos vêm da Wikipedia (a filtrar brasões/bandeiras).
PEXELS_KEY=
